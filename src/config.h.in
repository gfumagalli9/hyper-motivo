#ifndef MOTIVO_CONFIG_H
#define MOTIVO_CONFIG_H

#cmakedefine MOTIVO_HAS_BUILTIN_POPCOUNT 1
#cmakedefine MOTIVO_HAS_BUILTIN_POPCOUNTL 1

#define MOTIVO_SHORT_SIZE @MOTIVO_INT_SIZE@
#define MOTIVO_INT_SIZE @MOTIVO_INT_SIZE@
#define MOTIVO_LONG_SIZE @MOTIVO_LONG_SIZE@
#define MOTIVO_LONG_LONG_SIZE @MOTIVO_LONG_SIZE@

#cmakedefine MOTIVO_HAS_BUILTIN_ADD_OVERFLOW 1
#cmakedefine MOTIVO_HAS_BUILTIN_MUL_OVERFLOW 1
#cmakedefine MOTIVO_OVERFLOW_SAFE 1

#cmakedefine MOTIVO_HAS_UINT64_T 1
#cmakedefine MOTIVO_HAS_UINT128_T 1
#cmakedefine MOTIVO_HAS___UINT128_T 1

#cmakedefine MOTIVO_MULTITHREAD 1

#endif //MOTIVO_CONFIG_H
